# ==============================================================
# LookAhead - environment template (secret-free, safe to commit)
# ==============================================================
#
# This is a TEMPLATE: variable NAMES and safe defaults only, never a real key.
# Copy it to a local, git-ignored file, then fill in your values:
#
#   Windows PowerShell:  Copy-Item .env.example .env.local
#   Windows cmd:         copy .env.example .env.local
#   macOS / Linux:       cp .env.example .env.local
#
# After editing, restart the dev server so the new env is picked up:  npm run dev
#
# Every variable here is SERVER-SIDE ONLY. Neither the YouCam key nor the access
# code is ever bundled into the client or sent to the browser. Never commit
# .env.local - it is git-ignored (.gitignore: .env*.local).
#
# --------------------------------------------------------------
# HOW ACCESS WORKS (deployed / judging)
# --------------------------------------------------------------
# The app uses ONE shared YouCam key, held here on the server (YOUCAM_API_KEY).
# Judges/testers do NOT need their own key. Instead they enter a lightweight
# "Private Preview" access pass in the app; the server checks it against
# LOOKAHEAD_ACCESS_CODE and, if it matches, authorizes that browser with a
# temporary HTTP-only cookie. The key never leaves the server.
#
#   - Set PROVIDER_MODE=live + YOUCAM_API_KEY to use the real YouCam API.
#   - Set LOOKAHEAD_ACCESS_CODE to require the pass (production SHOULD set it).
#   - Leave LOOKAHEAD_ACCESS_CODE empty for local development with no gate.
# ==============================================================

# --- Provider mode --------------------------------------------
# mock = deterministic simulated adapters, zero credits (default, no key needed).
# live = real YouCam calls using the server YOUCAM_API_KEY below. With no key the
# app safely stays in mock and labels results simulated.
PROVIDER_MODE=mock

# --- YouCam / Perfect Corp credentials (SERVER-SIDE SECRET) -----
# The platform's Bearer token, used for ALL live provider calls. Get it from:
#   https://yce.makeupar.com/api-console/en/api-keys/
# REQUIRED for live mode. Never exposed to the browser, never logged, never
# committed. There is intentionally no NEXT_PUBLIC_ variant of this.
YOUCAM_API_KEY=

# --- Private Preview access pass (SERVER-SIDE SECRET) ---------
# The pass judges/testers type into the "Private Preview" screen to unlock the
# live experience (which then runs on the shared YOUCAM_API_KEY above).
#   - When set, the app requires a matching pass before it can be used.
#   - When empty, the gate is OFF (convenient for local development).
# Pick a long, unguessable value, e.g. LOOKAHEAD-XXXX-XXXX. Keep it out of git,
# source code, README, screenshots, and the client bundle. Never logged.
LOOKAHEAD_ACCESS_CODE=

# Provider base URL. Only override if your account is provisioned on a
# different host; the default below is correct for most accounts.
YOUCAM_BASE_URL=https://yce-api-01.makeupar.com

# Hairstyle VTO capability version, per your account provisioning:
#   v2.1 = hair-transfer (2 credits/preview, richer restyle) - default
#   v2.0 = hair-style     (1 credit/preview, preset styles)
YOUCAM_HAIRSTYLE_VERSION=v2.1

# --- Credit / budget controls ---------------------------------
# Server-enforced preview budget per session. 0 = unlimited (default).
# Credit math for a full session in LIVE mode:
#   - Hair record (Prepare step 3): Hair Length 2 + Hair Density 1 + Hair Type 2
#     = 5 credits, charged ONCE per photo set. Results are cached and reused, so
#     re-visiting or re-running never re-charges a part that already succeeded.
#   - Hairstyle preview (Rehearse "Preview this style"): 2 credits each (v2.1) or
#     1 credit each (v2.0), charged per successful NEW preview. Extension / bangs /
#     volume previews are billed per successful render by the provider.
# Previews stay behind explicit buttons and identical looks are reused, so credits
# are only spent on new, user-requested renders. Set a positive number here to
# re-impose a hard ceiling (safety escape hatch for live cost control).
MAX_PREVIEWS_PER_SESSION=0

# --- Async task polling ---------------------------------------
# Provider tasks are asynchronous; we poll until success/error or timeout.
TASK_POLL_INTERVAL_MS=1000
TASK_POLL_TIMEOUT_MS=120000

# --- Session + storage ----------------------------------------
# Anonymous session lifetime in ms (default = 7 days).
SESSION_TTL_MS=604800000

# Local runtime data dir (session JSON + stored photos). Git-ignored.
DATA_DIR=.data
